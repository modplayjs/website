{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modplayjs-webpage",
  "compatibility_date": "2026-11-09",
  "routes": [
    {
      "pattern": "modplayjs.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
