---
import '@fontsource/silkscreen/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import { androidVersion, libraryVersion, license, repository, xrVersion } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'modplayjs — a tracker and chiptune player engine in TypeScript, ported from libxmp, OpenMPT and cRSID and verified against the C references.',
} = Astro.props;

const path = Astro.url.pathname;
const items = [
  { no: '00', label: 'Index', href: '/', active: path === '/' },
  { no: '01', label: 'Android app', href: '/android', active: path.startsWith('/android') },
  { no: '02', label: 'XR app', href: '/xr', active: path.startsWith('/xr') },
  { no: '03', label: 'Library API', href: '/api', active: path.startsWith('/api') },
];
---

<!doctype html>
<html lang="en" data-theme="modplay">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-base-200 focus:px-4 focus:py-2 focus:font-mono focus:text-sm"
      >Skip to content</a
    >

    <div
      class="mx-auto grid w-full max-w-6xl grid-cols-1 px-4 sm:px-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-14 lg:px-8"
    >
      <aside
        class="flex items-center justify-between border-b border-base-300 py-5 lg:sticky lg:top-0 lg:flex lg:h-screen lg:flex-col lg:items-stretch lg:justify-start lg:border-b-0 lg:border-r lg:py-8 lg:pr-6"
      >
        <div class="flex w-full items-center justify-between gap-3 lg:block">
          <a href="/" class="font-display text-[1.05rem] leading-none tracking-tight">
            modplay<span class="text-primary">js</span>
          </a>

          <div class="dropdown dropdown-end lg:hidden">
            <div
              tabindex="0"
              role="button"
              class="btn btn-ghost btn-sm font-mono text-[0.68rem] uppercase tracking-[0.16em]"
            >
              Menu
            </div>
            <ul
              tabindex="0"
              class="menu dropdown-content z-30 mt-2 w-60 border border-base-300 bg-base-200 p-2"
            >
              {
                items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={item.active ? 'page' : undefined}
                      class:list={[item.active && 'bg-base-200 text-primary']}
                    >
                      <span class="font-mono text-[0.66rem] text-base-content/40">{item.no}</span>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <nav class="hidden lg:mt-10 lg:block lg:w-full" aria-label="Sections">
          <p class="mb-2 px-3 font-mono text-[0.62rem] uppercase tracking-[0.2em] text-base-content/35">
            Order
          </p>
          <ul class="menu menu-sm w-full gap-0.5 p-0">
            {
              items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.active ? 'page' : undefined}
                    class:list={[
                      'flex items-baseline gap-3 px-3 py-2 text-[0.8rem]',
                      item.active &&
                        'bg-base-200 text-primary shadow-[inset_2px_0_0_var(--color-primary)]',
                    ]}
                  >
                    <span class="font-mono text-[0.66rem] text-base-content/35">{item.no}</span>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-8 hidden border-t border-base-300 px-3 pt-4 lg:mt-auto lg:block">
          <dl class="space-y-1 font-mono text-[0.66rem] text-base-content/40">
            <div class="flex justify-between gap-3"><dt>library</dt><dd>{libraryVersion}</dd></div>
            <div class="flex justify-between gap-3"><dt>android</dt><dd>{androidVersion}</dd></div>
            <div class="flex justify-between gap-3"><dt>xr</dt><dd>{xrVersion}</dd></div>
            <div class="flex justify-between gap-3"><dt>license</dt><dd>{license}</dd></div>
          </dl>
        </div>
      </aside>

      <main id="main" class="min-w-0 pb-16 lg:py-10">
        <slot />

        <footer
          class="mt-20 flex flex-col gap-2 border-t border-base-300 pt-5 font-mono text-[0.68rem] text-base-content/35 sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© 2026 Bitti09 · {license}</p>
          <p>
            <a class="link link-hover hover:text-primary" href={repository}>source</a>
            <span class="mx-2 text-base-content/20">/</span>
            <span>no analytics, no cookies</span>
          </p>
        </footer>
      </main>
    </div>
  </body>
</html>
