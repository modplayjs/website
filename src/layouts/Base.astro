---
import '@fontsource/silkscreen/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';
import TopBar from '../components/TopBar.astro';

interface Props {
  title: string;
  description?: string;
  /** `top` is the landing layout: a top bar and full-width content, no rail. */
  layout?: 'rail' | 'top';
}

const {
  title,
  description = 'modplayjs — a tracker and chiptune player engine in TypeScript, ported from libxmp, OpenMPT and cRSID and verified against the C references.',
  layout = 'rail',
} = Astro.props;

const path = Astro.url.pathname;
const isTop = layout === 'top';
---

<!doctype html>
<html lang="en" data-theme="modplay">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-base-100 font-sans text-base-content antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-base-200 focus:px-4 focus:py-2 focus:font-mono focus:text-sm"
      >Skip to content</a
    >

    {isTop && <TopBar path={path} />}

    <div
      class:list={[
        'w-full',
        !isTop &&
          'mx-auto grid max-w-6xl grid-cols-1 px-4 sm:px-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-14 lg:px-8',
      ]}
    >
      {!isTop && <Rail path={path} />}

      <main
        id="main"
        class:list={[
          'min-w-0',
          isTop
            ? 'mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 lg:px-8'
            : 'pb-16 lg:py-10',
        ]}
      >
        <slot />
        <Footer />
      </main>
    </div>
  </body>
</html>
