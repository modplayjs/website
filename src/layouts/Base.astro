---
import '@fontsource/silkscreen/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import ApiNav from '../components/ApiNav.astro';
import Footer from '../components/Footer.astro';
import TopBar from '../components/TopBar.astro';

interface Props {
  title: string;
  description?: string;
  /** `top` is a single page under the top bar; `docs` adds the API sidebar. */
  layout?: 'top' | 'docs';
  /** Pages that must not be indexed (the 404) get no canonical and a robots tag. */
  noindex?: boolean;
}

const {
  title,
  description = 'modplayjs is a TypeScript tracker and chiptune engine: loaders ported from libxmp and OpenMPT, a cRSID-derived SID player, and Android and Quest shells.',
  layout = 'top',
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const isDocs = layout === 'docs';

// Static output is written as directory indexes, and Cloudflare serves a
// folder index with a trailing slash, so that is the canonical form.
const site = Astro.site;
const canonical =
  site && !noindex
    ? new URL(path.endsWith('/') ? path : `${path}/`, site).href
    : undefined;
const socialImage = site ? new URL('/og.png', site).href : undefined;

// The same two objects on every page: the site, and the code it documents.
// SoftwareSourceCode rather than SoftwareApplication, because the subject is a
// library; the apps have their own pages.
const structuredData = site && !noindex
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${site.href}#website`,
          url: site.href,
          name: 'modplayjs',
          description,
          inLanguage: 'en',
        },
        {
          '@type': 'SoftwareSourceCode',
          name: 'modplayjs',
          description:
            'A TypeScript tracker and chiptune engine: ported format loaders, a software mixer and plugin interfaces for formats, DSPs and outputs.',
          codeRepository: 'https://github.com/modplayjs/modplayjs',
          license: 'https://opensource.org/license/bsd-3-clause',
          programmingLanguage: 'TypeScript',
          author: { '@type': 'Person', name: 'Bitti09' },
        },
      ],
    }
  : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {site && <link rel="sitemap" href="/sitemap.xml" />}

    <meta property="og:site_name" content="modplayjs" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      socialImage && (
        <>
          <meta property="og:image" content={socialImage} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="modplayjs — tracker & chiptune engine" />
        </>
      )
    }
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>
  <body class="min-h-screen bg-base-300 font-sans text-base-content antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-base-200 focus:px-4 focus:py-2 focus:font-mono focus:text-sm"
      >Skip to content</a
    >

    <TopBar path={path} />

    {
      isDocs ? (
        <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-x-12">
            <aside class="hidden lg:block" aria-label="API contents">
              <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto border-r border-base-300 py-8 pr-5">
                <ApiNav path={path} />
              </div>
            </aside>

            <main id="main" class="min-w-0 pb-16 pt-6 lg:py-8">
              <details class="mb-8 border border-base-300 lg:hidden">
                <summary class="cursor-pointer px-4 py-3 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-base-content/60">
                  API contents
                </summary>
                <div class="border-t border-base-300 p-3">
                  <ApiNav path={path} />
                </div>
              </details>

              <slot />
              <Footer />
            </main>
          </div>
        </div>
      ) : (
        <main id="main" class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
          <slot />
          <Footer />
        </main>
      )
    }
  </body>
</html>
