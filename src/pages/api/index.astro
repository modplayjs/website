---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { categories, libraryVersion } from '../../data/site';

const total = categories.reduce((n, category) => n + category.packages.length, 0);
---

<Base title="Library API — modplayjs">
  <header class="border-b border-base-300 pb-8">
    <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-base-content/35">
      Reference / 03
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Library API</h1>
    <p class="mt-4 max-w-[66ch] text-[0.98rem] leading-relaxed text-base-content/65">
      {total} packages at version {libraryVersion}. The core owns timing and state; every other package
      is a plugin with one of three contracts — a format loader, a mixer, or an output. Nothing here
      is a framework: you register the parts you need and call them.
    </p>
  </header>

  <Section index="01" title="Categories" note="five groups">
    <div class="border-t border-base-300">
      {
        categories.map((category) => (
          <a
            href={`/api/${category.slug}`}
            class="group grid grid-cols-[2.5rem_minmax(0,1fr)_auto] gap-x-3 border-b border-base-300 py-4 transition-colors hover:bg-base-200/50 sm:grid-cols-[2.5rem_13rem_minmax(0,1fr)_auto] sm:items-baseline sm:gap-x-5"
          >
            <span class="font-mono text-[0.66rem] text-base-content/30">{category.order}</span>
            <span class="text-[0.92rem] text-base-content group-hover:text-primary">
              {category.title}
            </span>
            <span class="col-span-2 mt-1 max-w-[62ch] text-[0.8rem] leading-relaxed text-base-content/45 sm:col-span-1 sm:mt-0">
              {category.blurb}
            </span>
            <span class="col-span-2 mt-1 font-mono text-[0.62rem] text-base-content/30 sm:col-span-1 sm:mt-0">
              {category.packages.length} pkg
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <Section index="02" title="Install" note="GitHub Packages">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <p class="max-w-[62ch] text-[0.9rem] leading-relaxed text-base-content/60">
          Packages are published to GitHub Packages under the <span class="font-mono text-[0.82rem]">@modplayjs</span>
          scope. Add the scope to <span class="font-mono text-[0.82rem]">.npmrc</span> and install with a token
          that can read packages.
        </p>
        <pre
          class="mt-4 overflow-x-auto border border-base-300 bg-base-200 p-4 font-mono text-[0.72rem] leading-relaxed text-base-content/70"><code>@modplayjs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=&#36;&#123;GITHUB_TOKEN&#125;</code></pre>
      </div>
      <div>
        <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-base-content/35">
          One package or the whole set
        </p>
        <pre
          class="mt-4 overflow-x-auto border border-base-300 bg-base-200 p-4 font-mono text-[0.72rem] leading-relaxed text-base-content/70"><code>npm i @modplayjs/core @modplayjs/fmt-mod \
  @modplayjs/fmt-s3m @modplayjs/fmt-xm @modplayjs/fmt-it \
  @modplayjs/dsp-softmixer @modplayjs/out-webaudio</code></pre>
        <p class="mt-3 max-w-[56ch] font-mono text-[0.68rem] leading-relaxed text-base-content/35">
          A format package is only needed for the formats you open. The core does not import any of them.
        </p>
      </div>
    </div>
  </Section>

  <Section index="03" title="Three contracts" note="register, then call">
    <div class="grid gap-px border border-base-300 bg-base-300 lg:grid-cols-3">
      {
        [
          ['Format', 'test · load · readEvent', 'Parses a file into ModuleData and reads one row at a time during playback.'],
          ['DSP', 'renderFrame · onRow · reset', 'Turns channel state into interleaved stereo floats for one tick.'],
          ['Output', 'start · stop', 'Pulls from the core whenever its sink can take samples.'],
        ].map(([name, methods, text]) => (
          <div class="bg-base-100 p-4">
            <h3 class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-base-content">{name}</h3>
            <p class="mt-2 font-mono text-[0.66rem] text-primary/80">{methods}</p>
            <p class="mt-2 text-[0.8rem] leading-relaxed text-base-content/50">{text}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 max-w-[72ch] font-mono text-[0.68rem] leading-relaxed text-base-content/35">
      The full interfaces, including what a loader must fill in and what the core guarantees a DSP,
      are on the category pages. They are the same contracts the shipped loaders and mixers implement.
    </p>
  </Section>
</Base>
