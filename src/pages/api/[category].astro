---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { categories, formatRows } from '../../data/site';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const position = categories.indexOf(category);
const next = categories[(position + 1) % categories.length];

const loaderNames = new Set(category.packages.map((pkg) => pkg.name.replace('@modplayjs/', '')));
const formats = category.slug === 'formats' ? formatRows.filter((row) => loaderNames.has(row.loader)) : [];
---

<Base title={`${category.title} — modplayjs API`} description={category.blurb} layout="docs">
  <div class="breadcrumbs py-0 font-mono text-[0.64rem] text-base-content/30">
    <ul>
      <li><a href="/api" class="hover:text-primary">Library API</a></li>
      <li class="text-base-content/50">{category.title}</li>
    </ul>
  </div>

  <header class="mt-3 border-b border-base-300 pb-8">
    <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-base-content/35">
      Library API / {category.order}
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{category.title}</h1>
    <p class="mt-4 max-w-[66ch] text-[0.96rem] leading-relaxed text-base-content/65">
      {category.blurb}
    </p>
  </header>

  {
    category.snippet && (
      <div class="mt-8">
        <div class="border border-base-300">
          <div class="flex items-center justify-between gap-3 border-b border-base-300 px-4 py-2">
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-base-content/40">
              {category.snippet.title}
            </span>
            <span class="font-mono text-[0.58rem] uppercase tracking-[0.14em] text-base-content/25">
              TypeScript
            </span>
          </div>
          <pre class="overflow-x-auto bg-base-200/60 p-4 font-mono text-[0.72rem] leading-relaxed text-base-content/70"><code>{category.snippet.code}</code></pre>
        </div>
        {category.snippet.note && (
          <p class="mt-2 max-w-[72ch] font-mono text-[0.66rem] leading-relaxed text-base-content/35">
            {category.snippet.note}
          </p>
        )}
      </div>
    )
  }

  <Section index="01" title="Packages" note={`${category.packages.length} pkg`}>
    <div class="hidden border-b border-base-300 pb-2 sm:grid sm:grid-cols-[minmax(0,17rem)_4rem_minmax(0,1fr)] sm:gap-5">
      <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
        Package
      </span>
      <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
        Version
      </span>
      <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
        Role
      </span>
    </div>
    <div class="border-t border-base-300 sm:border-t-0">
      {
        category.packages.map((pkg) => (
          <div
            id={`pkg-${pkg.name.split('/').pop()}`}
            class="scroll-mt-24 grid gap-1 border-b border-base-300/60 py-3 sm:grid-cols-[minmax(0,17rem)_4rem_minmax(0,1fr)] sm:gap-5 sm:hover:bg-base-200/60"
          >
            <div class="min-w-0">
              <span class="break-all font-mono text-[0.78rem] text-base-content/90">{pkg.name}</span>
              {pkg.tag && (
                <span class="mt-1 block font-mono text-[0.58rem] uppercase tracking-[0.14em] text-warning/70">
                  {pkg.tag}
                </span>
              )}
            </div>
            <span class="font-mono text-[0.7rem] text-base-content/40 sm:pt-0.5">{pkg.version}</span>
            <p class="text-[0.84rem] leading-relaxed text-base-content/55 sm:pt-0.5">{pkg.role}</p>
          </div>
        ))
      }
    </div>
  </Section>

  {
    category.slug === 'formats' && (
      <Section index="02" title="Extensions" note={`${formats.length} rows`}>
        <div class="hidden border-b border-base-300 pb-2 sm:grid sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_8rem] sm:gap-5">
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
            Format
          </span>
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
            Extensions
          </span>
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
            Loader
          </span>
        </div>
        <div class="border-t border-base-300 sm:border-t-0">
          {formats.map((row) => (
            <div class="grid gap-1 border-b border-base-300/60 py-2.5 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_8rem] sm:gap-5 sm:hover:bg-base-200/60">
              <span class="text-[0.84rem] text-base-content/85">{row.format}</span>
              <span class="font-mono text-[0.72rem] text-base-content/55">{row.extensions}</span>
              <span class="font-mono text-[0.7rem] text-base-content/40">{row.loader}</span>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  <nav class="mt-16 flex items-center justify-between gap-4 border-t border-base-300 pt-5">
    <a href="/api" class="font-mono text-[0.66rem] uppercase tracking-[0.14em] text-base-content/35 hover:text-primary">
      ← All categories
    </a>
    <a
      href={`/api/${next.slug}`}
      class="text-right font-mono text-[0.66rem] uppercase tracking-[0.14em] text-base-content/50 hover:text-primary"
    >
      {next.order} · {next.title} →
    </a>
  </nav>
</Base>
