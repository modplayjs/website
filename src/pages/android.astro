---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Download from '../components/Download.astro';
import { androidVersion } from '../data/site';

const features = [
  {
    name: 'Library',
    text: 'Folder trees through the Storage Access Framework, walked recursively into a Room index. Favourites, ignore list, search, filters and sorting; a change in the engine’s format signature triggers one rescan.',
  },
  {
    name: 'Playback',
    text: 'The same engine as the library, running in V8 on its own thread. Float32 stereo into an AudioTrack at the device rate, with the queue and repeat/shuffle/auto-advance handled above it.',
  },
  {
    name: 'Favourites as a playlist',
    text: 'The favourites view queues itself: the next track is the next favourite, not the next file in the folder the track happens to live in.',
  },
  {
    name: 'Screen off',
    text: 'A mediaPlayback foreground service, a partial wake lock while playing, and a media session card with lock-screen controls. Audio focus is requested before the first frame is written.',
  },
  {
    name: 'Pattern view',
    text: 'Rows by channels of tracker text, following the row that is actually audible. Note, instrument, volume and effect each carry their own colour, set in Settings → Appearance.',
  },
  {
    name: 'Spatial diagnostics',
    text: 'What the platform reports about the current output: spatializer support, the channel beds it places, and whether a head tracker is present. The values are read-only; Android exposes no API to switch them on.',
  },
];

const screens = [
  ['Library', 'Folder browser with breadcrumbs, all-tracks view, search and filters.'],
  ['Favourites', 'One playlist, ordered by when each track was favourited.'],
  ['Playing', 'Transport, seek, queue, and two swipe drawers: the track’s folder and the mixer.'],
  ['Pattern', 'Realtime grid, one row per pattern row, with the audible row highlighted.'],
  ['Settings', 'Library, appearance, audio, spatial output, diagnostics and language.'],
];

const specs = [
  ['Platform', 'Android 15 (API 35) or newer'],
  ['Target API', '37'],
  ['ABI', 'arm64-v8a'],
  ['Engine', 'Bundled V8 isolate, no network at runtime'],
  ['Output', '32-bit float stereo, AudioTrack at the device sample rate'],
  ['Index', 'Room over Storage Access Framework grants'],
  ['License', 'BSD-3-Clause'],
];
---

<Base title="Android — modplayjs">
  <header class="border-b border-base-300 pb-8">
    <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-base-content/35">
      Surface / 01
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Android</h1>
    <p class="mt-4 max-w-[62ch] text-[0.98rem] leading-relaxed text-base-content/65">
      The phone shell: a library you can scan, a queue you can keep, and the engine from this site
      running natively in V8. Built for the screen that is in your pocket, not as a remote for
      anything.
    </p>
  </header>

  <Section index="01" title="Download" note={`version ${androidVersion}`}>
    <Download
      target="Android · arm64 APK"
      meta={`Version ${androidVersion} · Android 15 (API 35) or newer`}
      note="No build has been published yet. The first signed APK will be linked here; there is no Play listing to point at, and nothing to side-load before that."
    />
  </Section>

  <Section index="02" title="What it does" note="seven behaviours, not a feature grid">
    <ol class="border-t border-base-300">
      {
        features.map((feature, index) => (
          <li class="grid gap-2 border-b border-base-300 py-4 sm:grid-cols-[3rem_minmax(0,12rem)_minmax(0,1fr)] sm:gap-5">
            <span class="font-mono text-[0.66rem] text-base-content/30">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="text-[0.9rem] font-semibold text-base-content">{feature.name}</h3>
            <p class="max-w-[66ch] text-[0.86rem] leading-relaxed text-base-content/55">
              {feature.text}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section index="03" title="Screens" note="five destinations">
    <div class="overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr class="border-base-300">
            <th class="w-40 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
              Screen
            </th>
            <th class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-base-content/35">
              What it holds
            </th>
          </tr>
        </thead>
        <tbody>
          {
            screens.map(([name, text]) => (
              <tr class="border-base-300/60 hover:bg-base-200/60">
                <td class="py-2.5 align-top text-[0.86rem] text-base-content/85">{name}</td>
                <td class="py-2.5 align-top text-[0.84rem] leading-relaxed text-base-content/50">
                  {text}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section index="04" title="Specification" note="what the build actually ships">
    <dl class="border-t border-base-300">
      {
        specs.map(([key, value]) => (
          <div class="grid gap-1 border-b border-base-300 py-2.5 sm:grid-cols-[12rem_minmax(0,1fr)] sm:gap-5">
            <dt class="font-mono text-[0.66rem] uppercase tracking-[0.12em] text-base-content/35">
              {key}
            </dt>
            <dd class="text-[0.86rem] text-base-content/70">{value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>
</Base>
