---
import Base from '../layouts/Base.astro';
---

<Base title="404 — modplayjs">
  <div class="flex min-h-[55vh] flex-col justify-center">
    <p class="font-mono text-[0.64rem] uppercase tracking-[0.2em] text-base-content/35">Error / 404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">No such order position.</h1>
    <p class="mt-4 max-w-[52ch] text-[0.95rem] leading-relaxed text-base-content/60">
      This page is not in the order list. Nothing was renamed; the address is simply wrong.
    </p>
    <a
      href="/"
      class="btn btn-outline mt-8 w-fit border-base-300 font-mono text-[0.7rem] uppercase tracking-[0.14em]"
      >Back to index</a
    >
  </div>
</Base>
