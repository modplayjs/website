---
interface Props {
  index: string;
  title: string;
  note?: string;
}

const { index, title, note } = Astro.props;
---

<section class="mt-14">
  <div class="mb-5 flex items-baseline gap-3 border-b border-base-300 pb-2">
    <span class="font-mono text-[0.68rem] text-primary">§ {index}</span>
    <h2 class="text-[0.78rem] font-semibold uppercase tracking-[0.16em]">{title}</h2>
    {note && <span class="ml-auto hidden font-mono text-[0.64rem] text-base-content/30 sm:block">{note}</span>}
  </div>
  <slot />
</section>
